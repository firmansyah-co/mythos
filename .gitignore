# ==============================================================================
# MythOS Root Git Ignore
# ==============================================================================

# Rust Artifacts
target/
**/*.rs.bk
# Cargo.lock is kept for binary applications/workspaces

# Shared Memory, Sockets & MythOS Runtime Paths
/dev/shm/*
/var/lib/mythos/*
*.wal
*.dat
*.tmp
*.sock

# Node / Frontend Artifacts
node_modules/
dist/
.pnpm-store/
*.local
.env.local
.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# C / C++ & STruC++ Artifacts
*.so
*.dll
*.dylib
*.o
*.a
generated.cpp
generated.hpp

# IDE, OS & Editor Meta
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs & Diagnostics
*.log
logs/
