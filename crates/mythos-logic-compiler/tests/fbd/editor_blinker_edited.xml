            <block localId="41" typeName="XOR">
              <position x="120" y="340"/>
              <inputVariables>
                <variable formalParameter="IN1"><connectionPointIn><connection refLocalId="40"/></connectionPointIn></variable>
                <variable formalParameter="IN2"><connectionPointIn><connection refLocalId="41"/></connectionPointIn></variable>
              </inputVariables>
              <inOutVariables/>
              <outputVariables>
                <variable formalParameter="OUT"><connectionPointOut/></variable>
              </outputVariables>
            </block>
            <outVariable localId="42">
              <position x="240" y="340"/>
              <connectionPointIn><connection refLocalId="41"/></connectionPointIn>
              <expression>toggle</expression>
            </outVariable>
            <inVariable localId="50">
              <position x="0" y="430"/>
              <connectionPointOut/>
              <expression>count</expression>
            </inVariable>
            <block localId="51" typeName="INT_TO_REAL">
              <position x="120" y="430"/>
              <inputVariables>
                <variable formalParameter="IN"><connectionPointIn><connection refLocalId="50"/></connectionPointIn></variable>
              </inputVariables>
              <inOutVariables/>
              <outputVariables>
                <variable formalParameter="OUT"><connectionPointOut/></variable>
              </outputVariables>
            </block>
            <block localId="52" typeName="MUL">
              <position x="240" y="430"/>
              <inputVariables>
                <variable formalParameter="IN1"><connectionPointIn><connection refLocalId="51"/></connectionPointIn></variable>
                <variable formalParameter="IN2"><connectionPointIn><expression>0.5</expression></connectionPointIn></variable>
              </inputVariables>
              <inOutVariables/>
              <outputVariables>
                <variable formalParameter="OUT"><connectionPointOut/></variable>
              </outputVariables>
            </block>
            <connector localId="53" name="LVL">
              <position x="360" y="430"/>
              <connectionPointIn><connection refLocalId="52"/></connectionPointIn>
            </connector>
            <continuation localId="54" name="LVL">
              <position x="0" y="470"/>
              <connectionPointOut/>
            </continuation>
            <outVariable localId="55">
              <position x="120" y="470"/>
              <connectionPointIn><connection refLocalId="54"/></connectionPointIn>
              <expression>level</expression>
            </outVariable>
            <inVariable localId="60">
              <position x="0" y="520"/>
              <connectionPointOut/>
              <expression>toggle</expression>
            </inVariable>
            <jump localId="61" label="SKIP">
              <position x="120" y="520"/>
              <connectionPointIn><connection refLocalId="60"/></connectionPointIn>
            </jump>
            <inVariable localId="70">
              <position x="0" y="570"/>
              <connectionPointOut/>
              <expression>steps</expression>
            </inVariable>
            <inVariable localId="72">
              <position x="0" y="610"/>
              <connectionPointOut/>
              <expression>blink</expression>
