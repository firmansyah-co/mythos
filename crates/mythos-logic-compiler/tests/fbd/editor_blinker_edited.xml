            <block localId="71" typeName="ADD">
              <position x="120" y="570"/>
              <inputVariables>
                <variable formalParameter="EN"><connectionPointIn><connection refLocalId="72"/></connectionPointIn></variable>
                <variable formalParameter="IN1"><connectionPointIn><connection refLocalId="70"/></connectionPointIn></variable>
                <variable formalParameter="IN2"><connectionPointIn><expression>1</expression></connectionPointIn></variable>
              </inputVariables>
              <inOutVariables/>
              <outputVariables>
                <variable formalParameter="ENO"><connectionPointOut/></variable>
                <variable formalParameter="OUT"><connectionPointOut/></variable>
              </outputVariables>
            </block>
            <outVariable localId="73">
              <position x="240" y="570"/>
              <connectionPointIn><connection refLocalId="71" formalParameter="OUT"/></connectionPointIn>
              <expression>steps</expression>
            </outVariable>
            <outVariable localId="74" negated="true">
              <position x="240" y="610"/>
              <connectionPointIn><connection refLocalId="71" formalParameter="ENO"/></connectionPointIn>
              <expression>held</expression>
            </outVariable>
            <label localId="80" label="SKIP">
              <position x="0" y="680"/>
            </label>
          </FBD>
        </body><addData><data name="urn:mythos:logic:ld-editor" handleUnknown="preserve"><localIds xmlns="urn:mythos:logic:ld-editor" next="83"/></data></addData>
      </pou>
    </pous>
