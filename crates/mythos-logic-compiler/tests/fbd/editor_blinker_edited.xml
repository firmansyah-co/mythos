            </outVariable>
            <outVariable localId="35">
              <position x="360" y="270"/>
              <connectionPointIn><connection refLocalId="31" formalParameter="CV"/></connectionPointIn>
              <expression>count</expression>
            </outVariable>
            <inVariable localId="40">
