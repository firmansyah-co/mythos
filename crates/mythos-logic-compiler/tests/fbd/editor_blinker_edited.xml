<?xml version="1.0" encoding="utf-8"?>
<!--
  A Function Block Diagram that drives itself, for the emulated microcontrollers (ADR-013 §2.9)
  and the tests. Written by hand in PLCopen TC6 XML v2.01. Its networks, top to bottom:

  1. t2.Q into the negated input IN of the timer t1 (TON, PT 40 ms), whose Q is blink.
  2. blink to the timer t2 (TON, PT 40 ms): with network 1, blink is TRUE for a while and
     FALSE for a while.
  3. blink to the counter c (CTU, PV 5), reset by done as last written (an implicit loop): Q is
     done, CV count.
  4. done XOR the XOR's own output, drawn back (a feedback path): toggle changes whenever done.
  5. count as a REAL times 0.5, through the connector LVL to its continuation: level.
  6. toggle to a jump to SKIP, which skips network 7 while toggle is TRUE.
  7. steps := ADD(steps, 1) under EN blink; held := NOT ENO.
  SKIP: the label after network 7.
-->
<project xmlns="http://www.plcopen.org/xml/tc6_0201" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <fileHeader companyName="MythOS" productName="MythOS tests" productVersion="1" creationDateTime="2026-11-18T00:00:00"/>
  <contentHeader name="blinker">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="Blinker" pouType="program">
        <interface>
          <localVars>
            <variable name="t1"><type><derived name="TON"/></type></variable>
            <variable name="t2"><type><derived name="TON"/></type></variable>
            <variable name="c"><type><derived name="CTU"/></type></variable>
            <variable name="blink"><type><BOOL/></type></variable>
            <variable name="done"><type><BOOL/></type></variable>
            <variable name="toggle"><type><BOOL/></type></variable>
            <variable name="held"><type><BOOL/></type></variable>
            <variable name="count"><type><INT/></type></variable>
            <variable name="steps"><type><INT/></type><initialValue><simpleValue value="100"/></initialValue></variable>
            <variable name="level"><type><REAL/></type></variable>
          <variable name="pulse"><type><BOOL/></type></variable></localVars>
        </interface>
        <body>
          <FBD>
            <comment localId="1" height="20" width="300">
              <position x="0" y="-40"/>
              <content><xhtml:p>Two timers, each starting the other: blink is TRUE for 40 ms, FALSE for 40 ms.</xhtml:p></content>
            </comment>
            <inVariable localId="12">
              <position x="0" y="0"/>
              <connectionPointOut/>
              <expression>t2.Q</expression>
            </inVariable>
            <block localId="10" typeName="TON" instanceName="t1">
              <position x="120" y="0"/>
              <inputVariables>
                <variable formalParameter="IN" negated="true"><connectionPointIn><connection refLocalId="12"/></connectionPointIn></variable>
                <variable formalParameter="PT"><connectionPointIn><expression>T#40ms</expression></connectionPointIn></variable>
              </inputVariables>
              <inOutVariables/>
              <outputVariables>
                <variable formalParameter="Q"><connectionPointOut/></variable>
              </outputVariables>
            </block>
            <outVariable localId="11">
              <position x="240" y="0"/>
              <connectionPointIn><connection refLocalId="10" formalParameter="Q"/></connectionPointIn>
              <expression>blink</expression>
            </outVariable>
            <comment localId="82" height="24" width="200"><position x="0" y="90"/><content><xhtml:p xmlns:xhtml="http://www.w3.org/1999/xhtml"></xhtml:p></content><addData><data name="urn:mythos:logic:ld-network" handleUnknown="preserve"><network xmlns="urn:mythos:logic:ld-network" title="The second timer"/></data></addData></comment>
            <block localId="21" width="130" height="60" typeName="TON" instanceName="t2"><position x="130" y="140"/><inputVariables><variable formalParameter="IN"><connectionPointIn><relPosition x="0" y="30"/><connection refLocalId="20"/></connectionPointIn></variable><variable formalParameter="PT"><connectionPointIn><relPosition x="0" y="50"/><expression>T#40ms</expression></connectionPointIn></variable></inputVariables><inOutVariables/><outputVariables><variable formalParameter="Q"><connectionPointOut><relPosition x="130" y="30"/></connectionPointOut></variable></outputVariables></block>
            <inVariable localId="20" width="60" height="20"><position x="0" y="160"/><connectionPointOut><relPosition x="60" y="10"/></connectionPointOut><expression>blink</expression></inVariable>
            <outVariable localId="81" width="60" height="20"><position x="350" y="160"/><connectionPointIn><relPosition x="0" y="10"/><connection refLocalId="21" formalParameter="Q"/></connectionPointIn><expression>pulse</expression></outVariable>
            <inVariable localId="30">
              <position x="0" y="230"/>
              <connectionPointOut/>
              <expression>blink</expression>
            </inVariable>
            <inVariable localId="36">
              <position x="0" y="290"/>
              <connectionPointOut/>
              <expression>done</expression>
            </inVariable>
            <block localId="31" typeName="CTU" instanceName="c">
              <position x="240" y="230"/>
              <inputVariables>
