<?xml version="1.0" encoding="utf-8"?>
<!--
  A Ladder Diagram that drives itself, for the emulated microcontrollers (ADR-013 §2.9) and
  the tests. Written by hand in PLCopen TC6 XML v2.01. Its rungs, top to bottom:

  1. t2.Q through a normally closed contact to the timer t1 (TON, PT 40 ms), whose Q is the coil blink.
  2. blink to the timer t2 (TON, PT 40 ms): with rung 1, blink is TRUE for a while and FALSE for a while.
  3. blink through a rising contact to the counter c (CTU, PV 5, reset by done): Q is the coil done,
     CV the variable count.
  4. done to a set coil latched.
  5. blink through a falling contact to the coil fell.
  6. latched to a jump to DONE, which skips rung 7 once latched.
  7. steps := ADD(steps, 1).
  DONE: the label after rung 7.
-->
<project xmlns="http://www.plcopen.org/xml/tc6_0201" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <fileHeader companyName="MythOS" productName="MythOS tests" productVersion="1" creationDateTime="2026-11-18T00:00:00"/>
  <contentHeader name="oscillator">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="Oscillator" pouType="program">
        <interface>
          <localVars>
            <variable name="t1"><type><derived name="TON"/></type></variable>
            <variable name="t2"><type><derived name="TON"/></type></variable>
            <variable name="c"><type><derived name="CTU"/></type></variable>
            <variable name="blink"><type><BOOL/></type></variable>
            <variable name="done"><type><BOOL/></type></variable>
            <variable name="latched"><type><BOOL/></type></variable>
            <variable name="fell"><type><BOOL/></type></variable>
            <variable name="count"><type><INT/></type></variable>
            <variable name="steps"><type><INT/></type><initialValue><simpleValue value="100"/></initialValue></variable>
          </localVars>
        </interface>
        <body>
          <LD>
            <leftPowerRail localId="1">
              <position x="0" y="0"/>
              <connectionPointOut formalParameter=""/>
            </leftPowerRail>
            <comment localId="2" height="20" width="200">
              <position x="40" y="0"/>
              <content><xhtml:p>Two timers, each starting the other: on is TRUE for 40 ms, FALSE for 40 ms.</xhtml:p></content>
            </comment>
            <contact localId="10" negated="true">
              <position x="40" y="40"/>
              <connectionPointIn><connection refLocalId="1"/></connectionPointIn>
              <connectionPointOut/>
              <variable>t2.Q</variable>
            </contact>
            <inVariable localId="11">
              <position x="40" y="60"/>
              <connectionPointOut/>
              <expression>T#40ms</expression>
            </inVariable>
            <block localId="12" typeName="TON" instanceName="t1">
              <position x="120" y="40"/>
              <inputVariables>
                <variable formalParameter="IN"><connectionPointIn><connection refLocalId="10"/></connectionPointIn></variable>
                <variable formalParameter="PT"><connectionPointIn><connection refLocalId="11"/></connectionPointIn></variable>
              </inputVariables>
              <inOutVariables/>
              <outputVariables>
                <variable formalParameter="Q"><connectionPointOut/></variable>
                <variable formalParameter="ET"><connectionPointOut/></variable>
              </outputVariables>
            </block>
            <coil localId="13">
              <position x="300" y="40"/>
              <connectionPointIn><connection refLocalId="12" formalParameter="Q"/></connectionPointIn>
              <connectionPointOut/>
              <variable>blink</variable>
            </coil>
            <contact localId="20">
              <position x="40" y="100"/>
              <connectionPointIn><connection refLocalId="1"/></connectionPointIn>
              <connectionPointOut/>
              <variable>blink</variable>
            </contact>
            <block localId="21" typeName="TON" instanceName="t2">
              <position x="120" y="100"/>
              <inputVariables>
                <variable formalParameter="IN"><connectionPointIn><connection refLocalId="20"/></connectionPointIn></variable>
                <variable formalParameter="PT"><connectionPointIn><expression>T#40ms</expression></connectionPointIn></variable>
              </inputVariables>
              <inOutVariables/>
              <outputVariables>
                <variable formalParameter="Q"><connectionPointOut/></variable>
              </outputVariables>
            </block>
            <contact localId="30" edge="rising">
              <position x="40" y="160"/>
              <connectionPointIn><connection refLocalId="1"/></connectionPointIn>
              <connectionPointOut/>
              <variable>blink</variable>
            </contact>
            <inVariable localId="31">
              <position x="40" y="180"/>
              <connectionPointOut/>
              <expression>done</expression>
            </inVariable>
            <block localId="32" typeName="CTU" instanceName="c">
              <position x="120" y="160"/>
              <inputVariables>
                <variable formalParameter="CU"><connectionPointIn><connection refLocalId="30"/></connectionPointIn></variable>
                <variable formalParameter="R"><connectionPointIn><connection refLocalId="31"/></connectionPointIn></variable>
                <variable formalParameter="PV"><connectionPointIn><expression>5</expression></connectionPointIn></variable>
              </inputVariables>
              <inOutVariables/>
              <outputVariables>
                <variable formalParameter="Q"><connectionPointOut/></variable>
                <variable formalParameter="CV"><connectionPointOut/></variable>
              </outputVariables>
            </block>
            <coil localId="33">
              <position x="300" y="160"/>
              <connectionPointIn><connection refLocalId="32" formalParameter="Q"/></connectionPointIn>
              <connectionPointOut/>
              <variable>done</variable>
            </coil>
            <outVariable localId="34">
              <position x="300" y="200"/>
              <connectionPointIn><connection refLocalId="32" formalParameter="CV"/></connectionPointIn>
              <expression>count</expression>
            </outVariable>
            <contact localId="40">
              <position x="40" y="240"/>
              <connectionPointIn><connection refLocalId="1"/></connectionPointIn>
              <connectionPointOut/>
              <variable>done</variable>
            </contact>
            <coil localId="41" storage="set">
              <position x="300" y="240"/>
              <connectionPointIn><connection refLocalId="40"/></connectionPointIn>
              <connectionPointOut/>
              <variable>latched</variable>
            </coil>
            <contact localId="50" edge="falling">
              <position x="40" y="280"/>
              <connectionPointIn><connection refLocalId="1"/></connectionPointIn>
              <connectionPointOut/>
              <variable>blink</variable>
            </contact>
            <coil localId="51">
              <position x="300" y="280"/>
              <connectionPointIn><connection refLocalId="50"/></connectionPointIn>
              <connectionPointOut/>
              <variable>fell</variable>
            </coil>
            <contact localId="60">
              <position x="40" y="320"/>
              <connectionPointIn><connection refLocalId="1"/></connectionPointIn>
              <connectionPointOut/>
              <variable>latched</variable>
            </contact>
            <jump localId="61" label="DONE">
              <position x="120" y="320"/>
              <connectionPointIn><connection refLocalId="60"/></connectionPointIn>
            </jump>
            <inVariable localId="70">
              <position x="40" y="360"/>
              <connectionPointOut/>
              <expression>steps</expression>
            </inVariable>
            <block localId="71" typeName="ADD">
              <position x="120" y="360"/>
              <inputVariables>
                <variable formalParameter="IN1"><connectionPointIn><connection refLocalId="70"/></connectionPointIn></variable>
                <variable formalParameter="IN2"><connectionPointIn><expression>1</expression></connectionPointIn></variable>
              </inputVariables>
              <inOutVariables/>
              <outputVariables>
                <variable formalParameter="OUT"><connectionPointOut/></variable>
              </outputVariables>
            </block>
            <outVariable localId="72">
              <position x="300" y="360"/>
              <connectionPointIn><connection refLocalId="71"/></connectionPointIn>
              <expression>steps</expression>
            </outVariable>
            <label localId="80" label="DONE">
              <position x="0" y="400"/>
            </label>
            <rightPowerRail localId="90">
              <position x="400" y="0"/>
              <connectionPointIn><connection refLocalId="13"/></connectionPointIn>
              <connectionPointIn><connection refLocalId="33"/></connectionPointIn>
              <connectionPointIn><connection refLocalId="41"/></connectionPointIn>
              <connectionPointIn><connection refLocalId="51"/></connectionPointIn>
            </rightPowerRail>
          </LD>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations/>
  </instances>
</project>
