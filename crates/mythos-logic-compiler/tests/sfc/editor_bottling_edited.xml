<?xml version="1.0" encoding="utf-8"?>
<!-- A bottling line as a Sequential Function Chart (ADR-013 §2.17), moved by its steps' times
     alone, so that it runs with no input: on the emulated microcontrollers of
     scripts/logic-vm-on-emulators.sh as on a PC.
     Idle waits 60 ms; Convey moves a bottle (N conveyor, P CountBottle); every third bottle is
     rejected (a selection, the leftmost first: Reject, D alarm, P Discard), the others are filled and capped
     at once (a simultaneous divergence: Fill with S valve, DS label_ok and an inline action
     keeping fill_time; Cap with L capper); both done, Release resets valve and label_ok (R);
     then back to Idle by a jump. -->
<project xmlns="http://www.plcopen.org/xml/tc6_0201" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <fileHeader companyName="" productName="MythOS tests" productVersion="1" creationDateTime="2026-11-20T00:00:00Z"/>
  <contentHeader name="Bottling">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="Bottling" pouType="program">
        <interface>
          <outputVars>
            <variable name="conveyor"><type><BOOL/></type></variable>
            <variable name="valve"><type><BOOL/></type></variable>
            <variable name="capper"><type><BOOL/></type></variable>
            <variable name="alarm"><type><BOOL/></type></variable>
            <variable name="label_ok"><type><BOOL/></type></variable>
            <variable name="bottles"><type><INT/></type></variable>
            <variable name="rejected"><type><INT/></type></variable>
            <variable name="fill_time"><type><TIME/></type></variable>
          <variable name="idle_lamp"><type><BOOL/></type></variable></outputVars>
        </interface>
        <actions>
          <action name="CountBottle">
            <body><ST><xhtml:p>bottles := bottles + 1;</xhtml:p></ST></body>
          </action>
          <action name="Discard">
            <body><ST><xhtml:p>IF Discard.Q THEN
  rejected := rejected + 1;
END_IF;</xhtml:p></ST></body>
          </action>
        </actions>
        <transitions>
          <transition name="Filled">
            <body><ST><xhtml:p>Fill.T &gt;= T#100ms</xhtml:p></ST></body>
          </transition>
        </transitions>
        <body>
          <SFC>
            <step localId="1" name="Idle" initialStep="true" width="44" height="16"><position x="0" y="0"/><connectionPointOut formalParameter=""/><connectionPointOutAction formalParameter=""/></step>
            <actionBlock localId="91"><position x="60" y="0"/><connectionPointIn><connection refLocalId="1"/></connectionPointIn><action localId="92" qualifier="N"><relPosition x="0" y="0"/><reference name="idle_lamp"/></action></actionBlock>
            <transition localId="2"><position x="0" y="30"/><connectionPointIn><connection refLocalId="1"/></connectionPointIn><connectionPointOut/><condition><inline name=""><ST><xhtml:p>Idle.T &gt;= T#60ms</xhtml:p></ST></inline></condition></transition>
            <step localId="3" name="Convey" width="44" height="16"><position x="0" y="50"/><connectionPointIn><connection refLocalId="2"/></connectionPointIn><connectionPointOut formalParameter=""/><connectionPointOutAction formalParameter=""/></step>
            <actionBlock localId="4"><position x="60" y="50"/><connectionPointIn><connection refLocalId="3"/></connectionPointIn><action localId="5" qualifier="N"><relPosition x="0" y="0"/><reference name="conveyor"/></action><action localId="6" qualifier="P"><relPosition x="0" y="8"/><reference name="CountBottle"/></action></actionBlock>
            <selectionDivergence localId="7"><position x="0" y="80"/><connectionPointIn><connection refLocalId="3"/></connectionPointIn><connectionPointOut formalParameter=""/><connectionPointOut formalParameter=""/></selectionDivergence>
            <transition localId="8"><position x="0" y="90"/><connectionPointIn><connection refLocalId="7"/></connectionPointIn><connectionPointOut/><condition><inline name=""><ST><xhtml:p>bottles MOD 3 = 0 AND Convey.T &gt;= T#40ms</xhtml:p></ST></inline></condition></transition>
            <step localId="10" name="Reject" width="44" height="16"><position x="0" y="110"/><connectionPointIn><connection refLocalId="8"/></connectionPointIn><connectionPointOut formalParameter=""/><connectionPointOutAction formalParameter=""/></step>
            <actionBlock localId="11"><position x="60" y="110"/><connectionPointIn><connection refLocalId="10"/></connectionPointIn><action localId="12" qualifier="D" duration="T#20ms"><relPosition x="0" y="0"/><reference name="alarm"/></action><action localId="13" qualifier="P"><relPosition x="0" y="8"/><reference name="Discard"/></action></actionBlock>
            <transition localId="14"><position x="0" y="140"/><connectionPointIn><connection refLocalId="10"/></connectionPointIn><connectionPointOut/><condition><inline name=""><ST><xhtml:p>Reject.T &gt;= T#60ms</xhtml:p></ST></inline></condition></transition>
            <transition localId="9"><position x="160" y="90"/><connectionPointIn><connection refLocalId="7"/></connectionPointIn><connectionPointOut/><condition><inline name=""><ST><xhtml:p>Convey.T &gt;= T#80ms</xhtml:p></ST></inline></condition></transition>
            <simultaneousDivergence localId="15"><position x="160" y="110"/><connectionPointIn><connection refLocalId="9"/></connectionPointIn><connectionPointOut formalParameter=""/><connectionPointOut formalParameter=""/></simultaneousDivergence>
            <step localId="16" name="Fill" width="44" height="16"><position x="160" y="120"/><connectionPointIn><connection refLocalId="15"/></connectionPointIn><connectionPointOut formalParameter=""/><connectionPointOutAction formalParameter=""/></step>
            <actionBlock localId="17"><position x="220" y="120"/><connectionPointIn><connection refLocalId="16"/></connectionPointIn><action localId="18" qualifier="S"><relPosition x="0" y="0"/><reference name="valve"/></action><action localId="19" qualifier="DS" duration="T#40ms"><relPosition x="0" y="8"/><reference name="label_ok"/></action><action localId="20" qualifier="N"><relPosition x="0" y="16"/><inline><ST><xhtml:p>fill_time := Fill.T;</xhtml:p></ST></inline></action></actionBlock>
            <transition localId="21"><position x="160" y="160"/><connectionPointIn><connection refLocalId="16"/></connectionPointIn><connectionPointOut/><condition><reference name="Filled"/></condition></transition>
            <step localId="22" name="FillDone" width="44" height="16"><position x="160" y="180"/><connectionPointIn><connection refLocalId="21"/></connectionPointIn><connectionPointOut formalParameter=""/></step>
            <step localId="23" name="Cap" width="44" height="16"><position x="350" y="120"/><connectionPointIn><connection refLocalId="15"/></connectionPointIn><connectionPointOut formalParameter=""/><connectionPointOutAction formalParameter=""/></step>
            <actionBlock localId="24"><position x="410" y="120"/><connectionPointIn><connection refLocalId="23"/></connectionPointIn><action localId="25" qualifier="L" duration="T#60ms"><relPosition x="0" y="0"/><reference name="capper"/></action></actionBlock>
            <transition localId="26"><position x="350" y="150"/><connectionPointIn><connection refLocalId="23"/></connectionPointIn><connectionPointOut/><condition><inline name=""><ST><xhtml:p>Cap.T &gt;= T#70ms</xhtml:p></ST></inline></condition></transition>
            <step localId="27" name="CapDone" width="44" height="16"><position x="350" y="170"/><connectionPointIn><connection refLocalId="26"/></connectionPointIn><connectionPointOut formalParameter=""/></step>
            <simultaneousConvergence localId="28"><position x="160" y="210"/><connectionPointIn><connection refLocalId="22"/></connectionPointIn><connectionPointIn><connection refLocalId="27"/></connectionPointIn><connectionPointOut formalParameter=""/></simultaneousConvergence>
            <transition localId="29"><position x="160" y="220"/><connectionPointIn><connection refLocalId="28"/></connectionPointIn><connectionPointOut/><condition><inline name=""><ST><xhtml:p>TRUE</xhtml:p></ST></inline></condition></transition>
            <step localId="30" name="Release" width="44" height="16"><position x="160" y="240"/><connectionPointIn><connection refLocalId="29"/></connectionPointIn><connectionPointOut formalParameter=""/><connectionPointOutAction formalParameter=""/></step>
            <actionBlock localId="31"><position x="220" y="240"/><connectionPointIn><connection refLocalId="30"/></connectionPointIn><action localId="32" qualifier="R"><relPosition x="0" y="0"/><reference name="valve"/></action><action localId="33" qualifier="R"><relPosition x="0" y="8"/><reference name="label_ok"/></action></actionBlock>
            <transition localId="34"><position x="160" y="270"/><connectionPointIn><connection refLocalId="30"/></connectionPointIn><connectionPointOut/><condition><inline name=""><ST><xhtml:p>Release.T &gt;= T#20ms</xhtml:p></ST></inline></condition></transition>
            <selectionConvergence localId="35"><position x="0" y="290"/><connectionPointIn><connection refLocalId="14"/></connectionPointIn><connectionPointIn><connection refLocalId="34"/></connectionPointIn><connectionPointOut formalParameter=""/></selectionConvergence>
            <jumpStep localId="36" targetName="Idle"><position x="0" y="300"/><connectionPointIn><connection refLocalId="35"/></connectionPointIn></jumpStep>
            <comment localId="90" height="20" width="200">
              <position x="500" y="0"/>
              <content><xhtml:p>Every element of the chart</xhtml:p></content>
            </comment>
          </SFC>
        </body><addData><data name="urn:mythos:logic:ld-editor" handleUnknown="preserve"><localIds xmlns="urn:mythos:logic:ld-editor" next="93"/></data></addData>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations/>
  </instances>
</project>
