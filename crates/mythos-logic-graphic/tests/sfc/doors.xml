<?xml version="1.0" encoding="utf-8"?>
<!-- A Sequential Function Chart in a function block, called twice from a Function Block Diagram
     program of the same document (ADR-013 §2.17: one document, POUs of each language, one
     reader). The program's TON ticks every 90 ms; each tick commands a door, whose chart opens
     it (D opened after 30 ms) and closes it again once it has been open 100 ms and is
     commanded again. -->
<project xmlns="http://www.plcopen.org/xml/tc6_0201" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <fileHeader companyName="" productName="MythOS tests" productVersion="1" creationDateTime="2026-11-20T00:00:00Z"/>
  <contentHeader name="Doors">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="Door" pouType="functionBlock">
        <interface>
          <inputVars><variable name="cmd"><type><BOOL/></type></variable></inputVars>
          <outputVars>
            <variable name="motor"><type><BOOL/></type></variable>
            <variable name="opened"><type><BOOL/></type></variable>
          </outputVars>
        </interface>
        <body>
          <SFC>
            <step localId="1" name="Shut" initialStep="true">
              <position x="100" y="0"/>
              <connectionPointOut formalParameter=""/>
            </step>
            <transition localId="2">
              <position x="100" y="40"/>
              <connectionPointIn><connection refLocalId="1"/></connectionPointIn>
              <connectionPointOut/>
              <condition><inline name=""><ST><xhtml:p><![CDATA[cmd]]></xhtml:p></ST></inline></condition>
            </transition>
            <step localId="3" name="Open">
              <position x="100" y="80"/>
              <connectionPointIn><connection refLocalId="2"/></connectionPointIn>
              <connectionPointOut formalParameter=""/>
              <connectionPointOutAction formalParameter=""/>
            </step>
            <actionBlock localId="4">
              <position x="200" y="80"/>
              <connectionPointIn><connection refLocalId="3"/></connectionPointIn>
              <action localId="5" qualifier="N"><relPosition x="0" y="0"/><reference name="motor"/></action>
              <action localId="6" qualifier="D" duration="T#30ms"><relPosition x="0" y="20"/><reference name="opened"/></action>
            </actionBlock>
            <transition localId="7">
              <position x="100" y="120"/>
              <connectionPointIn><connection refLocalId="3"/></connectionPointIn>
              <connectionPointOut/>
              <condition><inline name=""><ST><xhtml:p><![CDATA[cmd AND Open.T >= T#100ms]]></xhtml:p></ST></inline></condition>
            </transition>
            <jumpStep localId="8" targetName="Shut">
              <position x="100" y="160"/>
              <connectionPointIn><connection refLocalId="7"/></connectionPointIn>
            </jumpStep>
          </SFC>
        </body>
      </pou>
      <pou name="Doors" pouType="program">
        <interface>
          <localVars>
            <variable name="tick"><type><TON/></type></variable>
            <variable name="front"><type><derived name="Door"/></type></variable>
            <variable name="back"><type><derived name="Door"/></type></variable>
          </localVars>
          <outputVars>
            <variable name="front_open"><type><BOOL/></type></variable>
            <variable name="back_motor"><type><BOOL/></type></variable>
          </outputVars>
        </interface>
        <body>
          <FBD>
            <inVariable localId="1"><position x="0" y="0"/><connectionPointOut/><expression>NOT tick.Q</expression></inVariable>
            <block localId="2" typeName="TON" instanceName="tick">
              <position x="100" y="0"/>
              <inputVariables>
                <variable formalParameter="IN"><connectionPointIn><connection refLocalId="1"/></connectionPointIn></variable>
                <variable formalParameter="PT"><connectionPointIn><expression>T#90ms</expression></connectionPointIn></variable>
              </inputVariables>
              <inOutVariables/>
              <outputVariables>
                <variable formalParameter="Q"><connectionPointOut/></variable>
                <variable formalParameter="ET"><connectionPointOut/></variable>
              </outputVariables>
            </block>
            <block localId="3" typeName="Door" instanceName="front">
              <position x="250" y="0"/>
              <inputVariables>
                <variable formalParameter="cmd"><connectionPointIn><connection refLocalId="2" formalParameter="Q"/></connectionPointIn></variable>
              </inputVariables>
              <inOutVariables/>
              <outputVariables>
                <variable formalParameter="motor"><connectionPointOut/></variable>
                <variable formalParameter="opened"><connectionPointOut/></variable>
              </outputVariables>
            </block>
            <outVariable localId="4"><position x="400" y="20"/><connectionPointIn><connection refLocalId="3" formalParameter="opened"/></connectionPointIn><expression>front_open</expression></outVariable>
            <inVariable localId="10"><position x="0" y="100"/><connectionPointOut/><expression>tick.Q</expression></inVariable>
            <block localId="11" typeName="Door" instanceName="back">
              <position x="250" y="100"/>
              <inputVariables>
                <variable formalParameter="cmd" negated="true"><connectionPointIn><connection refLocalId="10"/></connectionPointIn></variable>
              </inputVariables>
              <inOutVariables/>
              <outputVariables>
                <variable formalParameter="motor"><connectionPointOut/></variable>
                <variable formalParameter="opened"><connectionPointOut/></variable>
              </outputVariables>
            </block>
            <outVariable localId="12"><position x="400" y="100"/><connectionPointIn><connection refLocalId="11" formalParameter="motor"/></connectionPointIn><expression>back_motor</expression></outVariable>
          </FBD>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations/>
  </instances>
</project>
