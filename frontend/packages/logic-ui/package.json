{
  "name": "@mythos/logic-ui",
  "version": "0.9.0",
  "private": true,
  "description": "The workbench UI of the MythOS logic module: programs, the Structured Text editor, the project's library, bindings, check, load and run (ADR-013, ADR-014)",
  "mythos": {
    "module": "org.mythos.logic",
    "crate": "plugins/logic"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@mythos/workbench-sdk": "workspace:*",
    "lucide-react": "^1.59.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.1.0"
  }
}
