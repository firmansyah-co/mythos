{
  "name": "@mythos/data-ui",
  "version": "0.2.0",
  "private": true,
  "description": "The workbench UI of the MythOS data module: the project's user types and data blocks (ADR-014)",
  "mythos": {
    "module": "org.mythos.data",
    "crate": "plugins/data"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@mythos/workbench-sdk": "workspace:*",
    "lucide-react": "^1.59.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.1.0"
  }
}
