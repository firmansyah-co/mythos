{
  "name": "@mythos/ui-logic-editor",
  "version": "0.1.0",
  "description": "In-Canvas Monaco IEC 61131-3 Logic Editor plugin for MythOS Workbench",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build && tsc --declaration --declarationDir dist --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^1.59.0",
    "monaco-editor": "^0.52.2 || ^0.57.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}