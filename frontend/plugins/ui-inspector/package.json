{
  "name": "@mythos/ui-inspector",
  "version": "0.1.0",
  "description": "Slide-Over Context-Sensitive Inspector Drawer (Fixed 384px) for MythOS",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build && tsc --declaration --declarationDir dist --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@mythos/ui-faceplate-lib": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "tailwind-merge": "^3.0.0",
    "zustand": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}