{
  "name": "mythos-frontend-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "MythOS web workbench",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @mythos/ui-shell --filter @mythos/hmi-ui --filter @mythos/logic-ui --filter @mythos/data-ui run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm --filter @mythos/workbench-sdk --filter @mythos/ui-shell --filter @mythos/hmi-ui --filter @mythos/logic-ui --filter @mythos/data-ui run typecheck",
    "dev": "pnpm --filter @mythos/ui-shell run dev"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^21.0.3",
    "typescript": "^5.6.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.15"
  }
}
