#!/usr/bin/env bash
# Mechanical guard against the two failures that produced this repo's mess:
#   1. committing from a worktree whose branch already shipped
#   2. a blanket `git add -A` dragging runtime state into the index
set -uo pipefail

base="${BASE_REF:-origin/dev}"
fail=0

# 1. Stale world check (only when the base ref exists locally).
#    Two ways a world goes stale, and both must be refused:
#      a) the branch already shipped (HEAD is an ancestor of the base)
#      b) the branch has fallen so far behind the base that it is a different world
if git rev-parse --verify --quiet "$base" >/dev/null; then
    # A brand-new branch sits exactly on the base and is perfectly healthy, so
    # "already shipped" means a STRICT ancestor, not an equal commit.
    head_sha=$(git rev-parse HEAD 2>/dev/null || echo none)
    base_sha=$(git rev-parse "$base" 2>/dev/null || echo base)
    if git merge-base --is-ancestor HEAD "$base" 2>/dev/null && [ "$head_sha" != "$base_sha" ]; then
        echo "pre-commit: REFUSED — HEAD is already an ancestor of $base." >&2
        echo "  This branch has shipped. You are editing a finished slice." >&2
        echo "  Cut a new branch from $base, or ask dev_gatekeeper for a worktree." >&2
        fail=1
    else
        behind=$(git rev-list --count "HEAD..$base" 2>/dev/null || echo 0)
        if [ "${behind:-0}" -gt "${MAX_BEHIND:-0}" ] 2>/dev/null; then
            echo "pre-commit: REFUSED — HEAD is $behind commits behind $base." >&2
            echo "  You are committing into a world that moved on without you." >&2
            echo "  Rebase onto $base first, or cut a fresh branch from it." >&2
            fail=1
        fi
    fi

    # A commit that deletes merged work is almost always a bad merge base,
    # not a deliberate deletion. Refuse it before it becomes a PR.
    if git rev-parse --verify --quiet HEAD >/dev/null; then
        deleted=$(git diff --cached --diff-filter=D --name-only | wc -l | tr -d ' ')
        threshold="${ALLOW_DELETE_ABOVE:-40}"
        if [ "${deleted:-0}" -gt "$threshold" ] 2>/dev/null; then
            echo "pre-commit: REFUSED — this commit deletes $deleted files." >&2
            echo "  That is usually a stale merge base, not an intended removal." >&2
            echo "  Check: git diff --stat $base...HEAD" >&2
            echo "  Override for a real deletion: ALLOW_DELETE_ABOVE=$deleted git commit ..." >&2
            fail=1
        fi
    fi
fi

# 2. Runtime state in the index
runtime_hits=$(git diff --cached --name-only | grep -E \
    '(^|/)\.claude/(worktrees|autospin-)|(^|/)autospin-(state|logs|.*\.pid)|(^|/)\.openrig/|CLAUDE\.local\.md$' \
    || true)
if [ -n "$runtime_hits" ]; then
    echo "pre-commit: REFUSED — runtime state staged for commit:" >&2
    echo "$runtime_hits" | sed 's/^/  /' >&2
    echo "  Unstage with: git restore --staged <path>" >&2
    fail=1
fi

# 3. Obvious secret shapes
secret_hits=$(git diff --cached --name-only | grep -E '(^|/)\.env(\.|$)|(^|/)id_rsa|(^|/)\.npmrc$' || true)
if [ -n "$secret_hits" ]; then
    echo "pre-commit: REFUSED — possible secret file staged:" >&2
    echo "$secret_hits" | sed 's/^/  /' >&2
    fail=1
fi

exit "$fail"
