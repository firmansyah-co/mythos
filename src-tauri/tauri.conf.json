{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MythOS Industrial Workbench",
  "version": "0.1.0",
  "identifier": "com.firmansyah.mythos",
  "build": {
    "frontendDist": "../frontend/packages/ui-shell/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "MythOS Industrial Workbench",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0B0F17"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
