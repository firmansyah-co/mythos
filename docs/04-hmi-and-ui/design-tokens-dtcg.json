  "dimension": {
    "hud": {
      "height": {
        "$value": "38px",
        "$type": "dimension",
        "$description": "Fixed spatial height of Top SCADA HUD banner per Adrian Box-Model Rule"
      }
    },
    "activity-bar": {
      "width": {
        "$value": "48px",
        "$type": "dimension",
        "$description": "Fixed spatial width of Activity Bar selector per Adrian Box-Model Rule"
      }
    },
    "status-bar": {
      "height": {
        "$value": "24px",
        "$type": "dimension",
        "$description": "Fixed spatial height of Industrial Status Bar per Adrian Box-Model Rule"
      }
    },
    "primary-explorer": {
      "min-width": {
        "$value": "240px",
        "$type": "dimension",
