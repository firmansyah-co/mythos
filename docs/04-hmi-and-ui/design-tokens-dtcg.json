{
  "$schema": "https://design-tokens.github.io/community-group/format/2025.10/schema.json",
  "name": "MythOS High-Performance SCADA Design Tokens",
  "description": "W3C DTCG-compliant multi-theme design token suite for MythOS Mission-Critical Edge SCADA. Supports Dark Obsidian Mode (ANSI/ISA-101.01-2015 High-Performance HMI, ANSI/ISA-18.2-2016 Alarm Management, ISO 9241-110 Ergonomics) and Light Clean Slate Mode (High-contrast outdoor sunlight readability for industrial tablets and day shift plant operations).",
  "version": "2.0.0",
  "$themes": {
    "dark": {
      "id": "dark",
      "name": "SCADA Obsidian (Dark)",
      "description": "ISA-101 compliant muted dark obsidian palette for 24/7 mission-critical control rooms to minimize operator fatigue."
    },
    "light": {
      "id": "light",
      "name": "Engineering Clean Slate (Light / Day Shift)",
      "description": "High-contrast day shift and rugged outdoor tablet palette engineered for sunlight legibility and field commissioning."
    }
  },
  "color": {
    "background": {
      "base": {
        "$type": "color",
        "$description": "Deepest canvas background for SCADA workbench and container viewport",
        "$value": "{color.theme.dark.background.base}",
        "$extensions": {
          "mode": {
            "dark": "#0A0D12",
            "light": "#F8FAFC"
          }
        }
      },
      "surface": {
        "$type": "color",
        "$description": "Primary workbench surface, docking layout zone, and panel backing",
        "$value": "{color.theme.dark.background.surface}",
        "$extensions": {
          "mode": {
            "dark": "#0F141C",
            "light": "#FFFFFF"
          }
        }
      },
      "elevated": {
        "$type": "color",
        "$description": "Elevated cards, inspector drawers, modal sheets, and floating palettes",
        "$value": "{color.theme.dark.background.elevated}",
        "$extensions": {
          "mode": {
            "dark": "#161E2E",
            "light": "#F1F5F9"
          }
        }
      },
      "muted": {
        "$type": "color",
        "$description": "Muted vessel bodies, non-alarm process pipe fills, and inactive module slots",
        "$value": "{color.theme.dark.background.muted}",
        "$extensions": {
          "mode": {
            "dark": "#1E293B",
            "light": "#E2E8F0"
          }
        }
      },
      "highlight": {
        "$type": "color",
        "$description": "Subtle hover states and active tab outline highlighting",
        "$value": "{color.theme.dark.background.highlight}",
        "$extensions": {
          "mode": {
            "dark": "#334155",
            "light": "#CBD5E1"
          }
        }
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$description": "Subtle boundary borders between docking canvas zones",
        "$value": "{color.theme.dark.border.subtle}",
        "$extensions": {
          "mode": {
            "dark": "#1E293B",
            "light": "#E2E8F0"
          }
        }
      },
      "default": {
        "$type": "color",
        "$description": "Default structural separator, card boundary, and split pane divider",
        "$value": "{color.theme.dark.border.default}",
        "$extensions": {
          "mode": {
            "dark": "#334155",
            "light": "#CBD5E1"
          }
        }
      },
      "focus": {
        "$type": "color",
        "$description": "High-visibility focus ring indicator for accessible keyboard navigation",
        "$value": "{color.theme.dark.border.focus}",
        "$extensions": {
          "mode": {
            "dark": "#38BDF8",
            "light": "#0284C7"
          }
        }
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$description": "High-contrast telemetry readout values, primary engineering tags, and headers",
        "$value": "{color.theme.dark.text.primary}",
        "$extensions": {
          "mode": {
            "dark": "#F8FAFC",
            "light": "#0F172A"
          }
        }
      },
      "secondary": {
        "$type": "color",
        "$description": "Secondary metadata, engineering units (EU), descriptor labels, and subheadings",
        "$value": "{color.theme.dark.text.secondary}",
        "$extensions": {
          "mode": {
            "dark": "#94A3B8",
            "light": "#475569"
          }
        }
      },
      "muted": {
        "$type": "color",
        "$description": "Muted timestamps, disabled action controls, and watermark indicators",
        "$value": "{color.theme.dark.text.muted}",
        "$extensions": {
          "mode": {
            "dark": "#64748B",
            "light": "#64748B"
          }
        }
      },
      "inverse": {
        "$type": "color",
        "$description": "Text rendered over high-luminance alarm banners and active selection badges",
        "$value": "{color.theme.dark.text.inverse}",
        "$extensions": {
          "mode": {
            "dark": "#020617",
            "light": "#FFFFFF"
          }
        }
      }
    },
    "isa101": {
      "process": {
        "vessel": {
          "$type": "color",
          "$description": "ISA-101 compliant muted neutral tank and reactor structural fill",
          "$value": "{color.theme.dark.isa101.process.vessel}",
          "$extensions": {
            "mode": {
              "dark": "#334155",
              "light": "#E2E8F0"
            }
          }
        },
        "pipe-inactive": {
          "$type": "color",
          "$description": "ISA-101 unpressurized or zero-flow process piping line",
          "$value": "{color.theme.dark.isa101.process.pipe-inactive}",
          "$extensions": {
            "mode": {
              "dark": "#475569",
              "light": "#CBD5E1"
            }
          }
        },
        "pipe-active": {
          "$type": "color",
          "$description": "ISA-101 pressurized or flowing process line in nominal state (non-distracting)",
          "$value": "{color.theme.dark.isa101.process.pipe-active}",
          "$extensions": {
            "mode": {
              "dark": "#64748B",
              "light": "#94A3B8"
            }
          }
        },
        "valve-closed": {
          "$type": "color",
          "$description": "Muted static neutral symbol for closed digital valve",
          "$value": "{color.theme.dark.isa101.process.valve-closed}",
          "$extensions": {
            "mode": {
              "dark": "#475569",
              "light": "#94A3B8"
            }
          }
        },
        "valve-open": {
          "$type": "color",
          "$description": "Slightly elevated neutral symbol for open active flow valve",
          "$value": "{color.theme.dark.isa101.process.valve-open}",
          "$extensions": {
            "mode": {
              "dark": "#94A3B8",
              "light": "#475569"
            }
          }
        },
        "pump-running": {
          "$type": "color",
          "$description": "Subtle non-saturated cyan/blue indicator for energized rotary motor",
          "$value": "{color.theme.dark.isa101.process.pump-running}",
          "$extensions": {
            "mode": {
              "dark": "#0284C7",
              "light": "#0284C7"
            }
          }
        },
        "pump-stopped": {
          "$type": "color",
          "$description": "De-energized motor pump fill in normal stopped standby",
          "$value": "{color.theme.dark.isa101.process.pump-stopped}",
          "$extensions": {
            "mode": {
              "dark": "#475569",
              "light": "#94A3B8"
            }
          }
        }
      },
      "alarm": {
        "critical": {
          "$type": "color",
          "$description": "ISA-18.2 Priority 1 / Emergency Shutdown trip alarm. Flashes when unacknowledged.",
          "$value": "{color.theme.dark.isa101.alarm.critical}",
          "$extensions": {
            "mode": {
              "dark": "#DC2626",
              "light": "#DC2626"
            }
          }
        },
        "major": {
          "$type": "color",
          "$description": "ISA-18.2 Priority 2 / High process limit excursion requiring immediate operator action.",
          "$value": "{color.theme.dark.isa101.alarm.major}",
          "$extensions": {
            "mode": {
              "dark": "#EA580C",
              "light": "#D97706"
            }
          }
        },
        "minor": {
          "$type": "color",
          "$description": "ISA-18.2 Priority 3 / Low warning threshold excursion requiring scheduled intervention.",
          "$value": "{color.theme.dark.isa101.alarm.minor}",
          "$extensions": {
            "mode": {
              "dark": "#CA8A04",
              "light": "#CA8A04"
            }
          }
        },
        "diagnostic": {
          "$type": "color",
          "$description": "ISA-18.2 Priority 4 / Sensor fault, wire break, communication packet drop warning.",
          "$value": "{color.theme.dark.isa101.alarm.diagnostic}",
          "$extensions": {
            "mode": {
              "dark": "#2563EB",
              "light": "#2563EB"
            }
          }
        },
        "normal": {
          "$type": "color",
          "$description": "ISA-101 quiescent nominal process state. Strictly no flashing or vibrant accents.",
          "$value": "{color.theme.dark.isa101.alarm.normal}",
          "$extensions": {
            "mode": {
              "dark": "#475569",
              "light": "#64748B"
            }
          }
        },
        "shelved": {
          "$type": "color",
          "$description": "Operator-shelved or out-of-service point suppressed under ISA-18.2 Section 10.",
          "$value": "{color.theme.dark.isa101.alarm.shelved}",
          "$extensions": {
            "mode": {
              "dark": "#78716C",
              "light": "#94A3B8"
            }
          }
        }
      }
    },
    "bus": {
      "ethernet": {
        "$type": "color",
        "$description": "TIA Portal / PROFINET & Modbus TCP industrial green topology cable link",
        "$value": "{color.theme.dark.bus.ethernet}",
        "$extensions": {
          "mode": {
            "dark": "#16A34A",
            "light": "#15803D"
          }
        }
      },
      "serial": {
        "$type": "color",
        "$description": "TIA Portal / RS-485 Modbus RTU / PROFIBUS DP industrial blue cable link",
        "$value": "{color.theme.dark.bus.serial}",
        "$extensions": {
          "mode": {
            "dark": "#0284C7",
            "light": "#0369A1"
          }
        }
      },
      "can": {
        "$type": "color",
        "$description": "CANopen / DeviceNet fieldbus amber cable link",
        "$value": "{color.theme.dark.bus.can}",
        "$extensions": {
          "mode": {
            "dark": "#CA8A04",
            "light": "#B45309"
          }
        }
      },
      "safety": {
        "$type": "color",
        "$description": "PROFIsafe / SIL-3 Emergency Stop safety bus cable link",
        "$value": "{color.theme.dark.bus.safety}",
        "$extensions": {
          "mode": {
            "dark": "#DC2626",
            "light": "#DC2626"
          }
        }
      },
      "io-link": {
        "$type": "color",
        "$description": "Point-to-point IO-Link digital sensor line",
        "$value": "{color.theme.dark.bus.io-link}",
        "$extensions": {
          "mode": {
            "dark": "#9333EA",
            "light": "#7E22CE"
          }
        }
      },
      "offline": {
        "$type": "color",
        "$description": "Severed physical topology segment or timed-out ping beacon",
        "$value": "{color.theme.dark.bus.offline}",
        "$extensions": {
          "mode": {
            "dark": "#475569",
            "light": "#64748B"
          }
        }
      }
    },
